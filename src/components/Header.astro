---
import { copy, localeNames, localePath, locales, type Locale } from '../data/site';

interface Props { locale: Locale; switchPath?: string; }
const { locale, switchPath } = Astro.props;
const currentPath = switchPath ?? (Astro.url.pathname.replace(/^\/(ja|zh)(?=\/|$)/, '') || '/');
const t = copy[locale];
const links = [
  { label: t.nav.home, href: localePath(locale, '/') },
  { label: t.nav.research, href: localePath(locale, '/projects/') },
  { label: t.nav.publications, href: localePath(locale, '/publications/') },
  { label: t.nav.cv, href: localePath(locale, '/cv/') },
];
---

<header class="site-header">
  <a class="wordmark" href={localePath(locale, '/')} aria-label={t.aria.homeLabel}>
    <span>Xiaoyang Liu</span>
  </a>
  <nav class="primary-nav" aria-label={t.aria.primaryNavigation}>
    {links.map((link) => (
      <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <nav class="language-switcher" aria-label={t.aria.languageSelector}>
    <ul>
      {locales.map((item) => (
        <li><a class:list={{ active: item === locale }} href={localePath(item, currentPath)} lang={item} aria-current={item === locale ? 'page' : undefined}>
          {localeNames[item]}
        </a></li>
      ))}
    </ul>
  </nav>
</header>
