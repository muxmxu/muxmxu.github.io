---
import type { Locale } from '../data/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;

const copy = {
  en: {
    title: 'Listen with headphones',
    headphones: 'Please wear headphones for listening.',
  },
  ja: {
    title: 'ヘッドホンでお聴きください',
    headphones: '試聴の際はヘッドホンをご使用ください。',
  },
  zh: {
    title: '请佩戴耳机试听',
    headphones: '试听时请佩戴耳机。',
  },
} as const;

const t = copy[locale];
const audioRoot = '/demos/spatial-voice-conversion';
const samples = [
  { file: 'context_before_svc.wav', label: 'before-svc' },
  { file: 'context_target_timbre.wav', label: 'target-timbre' },
  { file: 'context_ideal.wav', label: 'Ideal SVC via simulation' },
  { file: 'ours.wav', label: 'ours' },
];
---

<section class="svc-demo" aria-labelledby="svc-demo-title">
  <header class="demo-heading">
    <h2 id="svc-demo-title">{t.title}</h2>
    <p>{t.headphones}</p>
  </header>

  <div class="demo-samples">
    {samples.map((sample) => (
      <article class="demo-sample">
        <h3>{sample.label}</h3>
        <audio controls preload="metadata" data-exclusive-playback aria-label={sample.label}>
          <source src={`${audioRoot}/${sample.file}`} type="audio/wav" />
        </audio>
      </article>
    ))}
  </div>
</section>

<script>
  const audioPlayers = document.querySelectorAll<HTMLAudioElement>('audio[data-exclusive-playback]');
  audioPlayers.forEach((player) => {
    player.addEventListener('play', () => {
      audioPlayers.forEach((otherPlayer) => {
        if (otherPlayer !== player) otherPlayer.pause();
      });
    });
  });
</script>

<style>
  .svc-demo {
    max-width: 1000px;
    margin: 86px 0 0 auto;
    padding-top: 72px;
    border-top: 1px solid var(--line-strong);
  }

  .demo-heading { margin-bottom: 34px; }
  .demo-heading h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -.035em;
  }
  .demo-heading p { margin: 13px 0 0; color: var(--muted); font-size: .95rem; }

  .demo-samples { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .demo-sample { min-width: 0; padding: 25px 24px 24px; border: 1px solid var(--line-strong); background: var(--paper); }
  .demo-sample h3 { margin: 0 0 28px; color: var(--ink); font-family: ui-monospace, monospace; font-size: .9rem; font-weight: 600; }
  .demo-sample audio { display: block; width: 100%; color-scheme: light; }

  @media (max-width: 620px) {
    .svc-demo { margin-top: 64px; padding-top: 56px; }
    .demo-samples { grid-template-columns: 1fr; }
  }
</style>
