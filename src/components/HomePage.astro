---
import PublicationList from './PublicationList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, educationLabUrl, localePath, socialProfiles, type Locale } from '../data/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const profileLinks = [
  { label: t.hero.publications, href: localePath(locale, '/publications/'), external: false, rel: undefined },
  { label: t.hero.projects, href: localePath(locale, '/projects/'), external: false, rel: undefined },
  { label: t.nav.cv, href: localePath(locale, '/cv/'), external: false, rel: undefined },
  { label: t.hero.educationLab, href: educationLabUrl, external: true, rel: 'external' },
  ...socialProfiles.map((profile) => ({
    label: 'handle' in profile ? `${profile.label} ${profile.handle}` : profile.label,
    href: profile.href,
    external: true,
    rel: 'me',
  })),
];
---

<BaseLayout locale={locale}>
  <section class="profile-intro shell">
    <div class="profile-intro__identity">
      <p class="profile-role">{t.hero.eyebrow}</p>
      <div class="profile-heading">
        <div>
          <h1>{t.hero.lead}</h1>
          <p class="profile-alternate-name">{t.hero.alternateName}</p>
        </div>
        <img class="profile-portrait" src="/images/xiaoyang-liu-chibi.png" alt={t.hero.portraitAlt} width="400" height="400" />
      </div>
      <p class="profile-bio">{t.hero.bio}</p>
    </div>
    <aside class="profile-intro__details" aria-label={t.hero.detailsLabel}>
      <dl class="profile-facts">
        {t.hero.facts.map((fact) => (
          <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
        ))}
      </dl>
      <nav class="profile-index" aria-label={t.hero.linksLabel}>
        <p>{t.hero.linksLabel}</p>
        <div>
          {profileLinks.map((link) => (
            <a href={link.href} rel={link.rel}>
              {link.label}<span aria-hidden="true">{link.external ? '↗' : '→'}</span>
            </a>
          ))}
          <button type="button" data-email-reveal>{t.hero.emailReveal}<span aria-hidden="true">+</span></button>
        </div>
      </nav>
    </aside>
  </section>

  <section class="academic-section shell" aria-labelledby="selected-publications">
    <div class="academic-section__heading">
      <div>
        <p>{t.sections.publicationsKicker}</p>
        <h2 id="selected-publications">{t.sections.publicationsTitle}</h2>
      </div>
      <a class="text-link" href={localePath(locale, '/publications/')}>{t.sections.allPublications}<span aria-hidden="true">↗</span></a>
    </div>
    <PublicationList locale={locale} featuredOnly />
  </section>

  <section class="academic-section academic-section--research shell" aria-labelledby="research-interests">
    <div class="academic-section__heading">
      <div>
        <p>{t.sections.researchKicker}</p>
        <h2 id="research-interests">{t.sections.researchTitle}</h2>
      </div>
      <a class="text-link" href={localePath(locale, '/projects/')}>{t.sections.allProjects}<span aria-hidden="true">↗</span></a>
    </div>
    <ol class="interest-list">
      {t.researchAreas.map((area) => (
        <li>
          <span>{area.index}</span>
          <div><h3>{area.title}</h3><p>{area.text}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="personal-section shell" aria-labelledby="outside-the-lab">
    <div class="personal-section__copy">
      <p>{t.personal.kicker}</p>
      <h2 id="outside-the-lab">{t.personal.title}</h2>
      <p>{t.personal.text}</p>
    </div>
    <dl class="strength-stats" aria-label={t.personal.statsLabel}>
      {t.personal.lifts.map((lift) => (
        <div><dt>{lift.label}</dt><dd>{lift.value}</dd></div>
      ))}
    </dl>
  </section>
</BaseLayout>

<script>
  const emailKey = 73;
  const encodedEmail = [36, 60, 49, 103, 49, 37, 32, 60, 9, 34, 44, 32, 38, 103, 35, 57];

  document.querySelectorAll<HTMLButtonElement>('[data-email-reveal]').forEach((button) => {
    button.addEventListener('click', () => {
      const address = String.fromCharCode(...encodedEmail.map((code) => code ^ emailKey));
      const link = document.createElement('a');
      link.href = `mailto:${address}`;
      link.textContent = address;
      link.rel = 'nofollow';
      button.replaceWith(link);
      link.focus();
    }, { once: true });
  });
</script>
